<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>EasyColab</RootNamespace>
    <AssemblyName>EasyColab</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <Product>EasyColab</Product>
    <Company>EasyColab Open Source</Company>
    <Description>EasyColab AI Studio</Description>
    <NoWarn>$(NoWarn);CS1998;MVVMTK0045;MVVMTK0049</NoWarn>
  </PropertyGroup>

  <!-- Version is sourced from the repository-level VERSION file -->
  <PropertyGroup>
    <EasyColabVersionFile>$(MSBuildThisFileDirectory)..\..\VERSION</EasyColabVersionFile>
    <EasyColabVersion Condition="Exists('$(EasyColabVersionFile)')">$([System.IO.File]::ReadAllText('$(EasyColabVersionFile)').Trim())</EasyColabVersion>
    <EasyColabVersion Condition="'$(EasyColabVersion)' == ''">1.0.0</EasyColabVersion>
    <Version>$(EasyColabVersion)</Version>
    <InformationalVersion>$(EasyColabVersion)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Shared repository resources (bridge + server) copied next to EasyColab.exe -->
  <ItemGroup>
    <Content Include="..\..\VERSION;..\..\colab_bridge.py;..\..\app.py;..\..\runtime_auth.py;..\..\EasyColab_Server.ipynb;..\..\requirements.txt">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\assets\AppIcon.ico;..\assets\AppIcon.png">
      <Link>Assets\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
