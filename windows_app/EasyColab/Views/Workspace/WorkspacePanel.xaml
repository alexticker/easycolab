<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EasyColab.Views.Workspace.WorkspacePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:EasyColab.Controls"
    xmlns:loc="using:EasyColab.Localization"
    xmlns:local="using:EasyColab.Views.Workspace">

    <UserControl.Resources>
        <!-- Preserve native WinUI 3 Fluent 2 TextBox appearance -->
        <Style x:Key="WorkspacePromptBoxStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer
        x:Name="WorkspaceScrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            MaxWidth="1180"
            Padding="20"
            HorizontalAlignment="Stretch">
            <StackPanel Spacing="16">

                <!-- 1. Top Model Overview & Mode Switcher Header (Fluent 2 card) -->
                <Border
                    Padding="16"
                    Background="{ThemeResource StudioWorkspaceCardFillBrush}"
                    BorderBrush="{ThemeResource StudioCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Model Icon Badge -->
                            <Border
                                Width="32"
                                Height="32"
                                VerticalAlignment="Center"
                                Background="{ThemeResource StudioAccentBlueFillBrush}"
                                CornerRadius="8">
                                <FontIcon
                                    x:Name="ModelHeaderIcon"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource StudioSystemAccentBrush}"
                                    Glyph="&#xE8B2;" />
                            </Border>

                            <!-- Model Name, RepoId & Summary -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        x:Name="ModelHeaderNameText"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                                    <Border
                                        Padding="7,2"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource StudioPrimaryOpacity06Brush}"
                                        CornerRadius="10">
                                        <TextBlock
                                            x:Name="ModelHeaderRepoText"
                                            FontFamily="{StaticResource StudioMonoFont}"
                                            FontSize="11"
                                            Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    x:Name="ModelHeaderSummaryText"
                                    FontSize="11.5"
                                    Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Right VRAM & Co-Residency Status Pills -->
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Border
                                    x:Name="CoResidentPill"
                                    Padding="8,5"
                                    Background="{ThemeResource StudioAccentBlueFillBrush}"
                                    CornerRadius="10"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource StudioSystemAccentBrush}"
                                            Glyph="&#xE81E;" />
                                        <TextBlock
                                            x:Name="CoResidentText"
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource StudioSystemAccentBrush}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Height="24"
                                    Padding="10,0"
                                    Background="{ThemeResource StudioInputFillBrush}"
                                    BorderBrush="{ThemeResource StudioCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <c:StatusDot x:Name="VramStatusDot" />
                                        <TextBlock
                                            x:Name="VramStatusText"
                                            FontSize="11.5"
                                            FontWeight="Medium" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Mode Switcher Cards (equal-width columns) -->
                        <Grid x:Name="ModeCardsGrid" ColumnSpacing="12" />
                    </StackPanel>
                </Border>

                <!-- Branch A: ComfyUI Cloud Node Studio -->
                <local:ComfyUIWorkspaceView x:Name="ComfyUIView" Visibility="Collapsed" />

                <!-- Branch B: Dual-Protocol API Gateway -->
                <local:ApiGatewayView x:Name="ApiGatewayViewHost" Visibility="Collapsed" />

                <!-- Branch C: Standard Multimodal Creation / Chat Studio -->
                <StackPanel x:Name="StandardStudioPanel" Spacing="16">

                    <!-- 2. Reference Image Drop Wells (fl2va / i2v / i2i_edit / vlm) -->
                    <c:WorkspaceCard x:Name="ReferenceImageCard" Visibility="Collapsed">
                        <Grid x:Name="ReferenceWellsGrid" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="FirstWellColumn" Width="*" />
                                <ColumnDefinition x:Name="SecondWellColumn" Width="*" />
                            </Grid.ColumnDefinitions>

                            <c:FrameDropWell
                                x:Name="FirstFrameWell"
                                Grid.Column="0"
                                ImagePath="{x:Bind ViewModel.FirstFrameImage, Mode=TwoWay}"
                                ImagePathChanged="FrameWell_ImagePathChanged" />

                            <c:FrameDropWell
                                x:Name="LastFrameWell"
                                Grid.Column="1"
                                ImagePath="{x:Bind ViewModel.LastFrameImage, Mode=TwoWay}"
                                ImagePathChanged="FrameWell_ImagePathChanged" />
                        </Grid>
                    </c:WorkspaceCard>

                    <!-- 3. Prompt Composer Section -->
                    <c:WorkspaceCard x:Name="PromptComposerCard" Icon="&#xE8E4;">
                        <c:WorkspaceCard.Trailing>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <DropDownButton
                                    x:Name="PresetTemplatesButton"
                                    Padding="9,4"
                                    FontSize="11.5"
                                    ToolTipService.ToolTip="{loc:L Zh='填入当前模型精选提示词模板', En='Insert curated prompt templates for the active model'}">
                                    <DropDownButton.Content>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon FontSize="11.5" Glyph="&#xE8D2;" />
                                            <TextBlock Text="{loc:L Zh='示例模板', En='Templates'}" />
                                        </StackPanel>
                                    </DropDownButton.Content>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout x:Name="PresetTemplatesFlyout" Opening="PresetTemplatesFlyout_Opening" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>

                                <Button
                                    x:Name="ClearPromptsButton"
                                    Padding="9,4"
                                    Click="ClearPromptsButton_Click"
                                    FontSize="11.5"
                                    ToolTipService.ToolTip="{loc:L Zh='清空当前提示词输入', En='Clear current prompt inputs'}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon FontSize="11" Glyph="&#xE74D;" />
                                        <TextBlock Text="{loc:L Zh='清空', En='Clear'}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </c:WorkspaceCard.Trailing>

                        <StackPanel Spacing="12">
                            <!-- Primary Prompt Editor -->
                            <StackPanel Spacing="6">
                                <TextBlock
                                    x:Name="VisualPromptLabel"
                                    FontSize="11.5"
                                    FontWeight="Medium"
                                    Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                <TextBox
                                    x:Name="VisualPromptBox"
                                    Height="92"
                                    PreviewKeyDown="PromptBox_PreviewKeyDown"
                                    Style="{StaticResource WorkspacePromptBoxStyle}"
                                    Text="{x:Bind ViewModel.VisualPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextChanged="PromptBox_TextChanged" />
                            </StackPanel>

                            <!-- VideoAudio: Soundscape & Music Editors -->
                            <Grid
                                x:Name="AudioPromptsRow"
                                ColumnSpacing="12"
                                Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock
                                        FontSize="11.5"
                                        FontWeight="Medium"
                                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                        Text="{loc:L Zh='环境音效与台词对白（可选）', En='Soundscape, Foley &amp; Dialogue (Optional)'}" />
                                    <TextBox
                                        x:Name="SoundscapePromptBox"
                                        Height="58"
                                        PlaceholderText="{loc:L Zh='如：海浪拍岸声、脚步声、角色轻声说台词...', En='e.g. Ocean waves crashing, footsteps on gravel, spoken dialogue...'}"
                                        PreviewKeyDown="PromptBox_PreviewKeyDown"
                                        Style="{StaticResource WorkspacePromptBoxStyle}"
                                        Text="{x:Bind ViewModel.SoundscapePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextChanged="PromptBox_TextChanged" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock
                                        FontSize="11.5"
                                        FontWeight="Medium"
                                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                        Text="{loc:L Zh='背景音乐风格（可选）', En='Background Music Style (Optional)'}" />
                                    <TextBox
                                        x:Name="MusicPromptBox"
                                        Height="58"
                                        PlaceholderText="{loc:L Zh='如：温暖大提琴与原声吉他电影配乐...', En='e.g. Warm cinematic cello and acoustic guitar score...'}"
                                        PreviewKeyDown="PromptBox_PreviewKeyDown"
                                        Style="{StaticResource WorkspacePromptBoxStyle}"
                                        Text="{x:Bind ViewModel.MusicPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextChanged="PromptBox_TextChanged" />
                                </StackPanel>
                            </Grid>

                            <!-- VideoAudio: Collapsible Negative Prompt Disclosure -->
                            <StackPanel
                                x:Name="VideoAudioNegativeSection"
                                Spacing="6"
                                Visibility="Collapsed">
                                <Button
                                    x:Name="ToggleNegativePromptButton"
                                    HorizontalAlignment="Left"
                                    Click="ToggleNegativePromptButton_Click"
                                    Style="{StaticResource StudioPlainButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            x:Name="NegativeChevronIcon"
                                            FontSize="10"
                                            Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                            Glyph="&#xE76C;" />
                                        <TextBlock
                                            FontSize="11.5"
                                            FontWeight="Medium"
                                            Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                            Text="{loc:L Zh='反向提示词 Negative Prompt（可选，排除低质或多余元素）', En='Negative Prompt (Optional — exclude artifacts or unwanted elements)'}" />
                                    </StackPanel>
                                </Button>

                                <StackPanel
                                    x:Name="VideoAudioNegativeBody"
                                    Padding="0,4,0,0"
                                    Spacing="6"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        FontSize="11.5"
                                        FontWeight="Medium"
                                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                        Text="{loc:L Zh='反向排除项', En='Negative Terms'}" />
                                    <TextBox
                                        x:Name="VideoAudioNegativeBox"
                                        Height="44"
                                        PlaceholderText="{loc:L Zh='如：模糊、畸变、水印、多余肢体、画面闪烁...', En='e.g. blurry, distorted, watermark, extra limbs, flickering...'}"
                                        PreviewKeyDown="PromptBox_PreviewKeyDown"
                                        Style="{StaticResource WorkspacePromptBoxStyle}"
                                        Text="{x:Bind ViewModel.NegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextChanged="PromptBox_TextChanged" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Image (non-MiniMaxH3) / Video: Direct Negative Prompt -->
                            <StackPanel
                                x:Name="DirectNegativeSection"
                                Spacing="6"
                                Visibility="Collapsed">
                                <TextBlock
                                    FontSize="11.5"
                                    FontWeight="Medium"
                                    Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                    Text="{loc:L Zh='反向提示词 Negative Prompt（可选，排除低质或多余元素）', En='Negative Prompt (Optional — exclude low quality or unwanted elements)'}" />
                                <TextBox
                                    x:Name="DirectNegativeBox"
                                    Height="46"
                                    PlaceholderText="{loc:L Zh='如：模糊、低分辨率、畸变、水印、杂乱文字...', En='e.g. blurry, low resolution, deformed, watermark, garbled text...'}"
                                    PreviewKeyDown="PromptBox_PreviewKeyDown"
                                    Style="{StaticResource WorkspacePromptBoxStyle}"
                                    Text="{x:Bind ViewModel.NegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextChanged="PromptBox_TextChanged" />
                            </StackPanel>
                        </StackPanel>
                    </c:WorkspaceCard>

                    <!-- 4. Generate Action Section -->
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="GenerateButton"
                                Grid.Column="0"
                                Height="38"
                                Padding="16,0"
                                HorizontalAlignment="Stretch"
                                Click="GenerateButton_Click"
                                CornerRadius="6"
                                Style="{StaticResource StudioPrimaryButtonStyle}">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                                </Button.KeyboardAccelerators>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <ProgressRing
                                        x:Name="GenerateSpinner"
                                        Width="14"
                                        Height="14"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                    <FontIcon
                                        x:Name="GenerateButtonIcon"
                                        FontSize="12.5"
                                        Glyph="&#xE768;" />
                                    <TextBlock
                                        x:Name="GenerateButtonText"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="CancelGenerationButton"
                                Grid.Column="1"
                                MinHeight="40"
                                Padding="14,7"
                                Background="{ThemeResource StudioAccentRedFillBrush}"
                                BorderBrush="{ThemeResource StudioAccentRedBrush}"
                                Click="CancelGenerationButton_Click"
                                Foreground="{ThemeResource StudioAccentRedBrush}"
                                ToolTipService.ToolTip="{loc:L Zh='立即中断当前云端推理任务并解锁操作', En='Abort the running cloud GPU job immediately'}"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon FontSize="11.5" Glyph="&#xE71A;" />
                                    <TextBlock
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        Text="{loc:L Zh='停止推理', En='Stop'}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Live Progress Bar -->
                        <Grid
                            x:Name="ProgressRow"
                            ColumnSpacing="8"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar
                                x:Name="GenerationProgressBar"
                                VerticalAlignment="Center"
                                Maximum="1"
                                Minimum="0"
                                Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                            <TextBlock
                                x:Name="GenerationProgressText"
                                Grid.Column="1"
                                Width="42"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource StudioMonoFont}"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioSystemAccentBrush}"
                                TextAlignment="Right" />
                        </Grid>

                        <!-- Status Message Readout -->
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Margin="0,2,0,0"
                                VerticalAlignment="Top"
                                FontSize="12"
                                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                Glyph="&#xE946;" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="12.5"
                                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.DisplayStatusMessage, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>

                    <!-- 5. Adaptive Preview Section: LLM Conversation OR Media Preview + Local History -->
                    <local:LlmConversationCard x:Name="LlmConversationHost" Visibility="Collapsed" />

                    <Grid
                        x:Name="MediaSplitHost"
                        ColumnSpacing="14"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="242" />
                        </Grid.ColumnDefinitions>

                        <local:MediaPreviewCard x:Name="MediaPreviewControl" Grid.Column="0" />
                        <local:MediaHistoryCard x:Name="MediaHistoryControl" Grid.Column="1" />
                    </Grid>
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
