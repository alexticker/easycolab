<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EasyColab.Views.MainStudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:EasyColab.Controls"
    xmlns:dialogs="using:EasyColab.Views.Dialogs"
    xmlns:loc="using:EasyColab.Localization"
    xmlns:views="using:EasyColab.Views"
    xmlns:ws="using:EasyColab.Views.Workspace">

    <Grid x:Name="PageRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Unified Windows 11 Mica Title Bar (48px tall) -->
        <Grid
            Grid.Row="0"
            Padding="14,0,0,0"
            Background="Transparent"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarCaptionSpacer" Width="138" />
            </Grid.ColumnDefinitions>

            <!-- Dedicated Draggable Title Bar Region: App Icon + Title + Live Telemetry Status -->
            <Border
                x:Name="TitleBarDragRegion"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <!-- EasyColab 20x20 Cloud + Spark Vector Brand Icon -->
                    <Grid
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center">
                        <Border Background="#FFE0F2FA" CornerRadius="5" />
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="White"
                            Glyph="&#xE753;" />
                        <Canvas Width="20" Height="20" IsHitTestVisible="False">
                            <Polyline
                                Points="5.5,11.7 10,8.5 14.5,11.7"
                                Stroke="#FFFA6E30"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeThickness="1.5" />
                            <Ellipse Canvas.Left="4.35" Canvas.Top="10.55" Width="2.3" Height="2.3" Fill="#FFFF9445" />
                            <Ellipse Canvas.Left="8.85" Canvas.Top="7.35" Width="2.3" Height="2.3" Fill="#FFFF9445" />
                            <Ellipse Canvas.Left="13.35" Canvas.Top="10.55" Width="2.3" Height="2.3" Fill="#FFFF9445" />
                        </Canvas>
                    </Grid>

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource StudioTextPrimaryBrush}"
                        Text="EasyColab" />

                    <Border
                        Width="1"
                        Height="14"
                        Margin="2,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource StudioSplitDividerBrush}" />

                    <!-- Live Status Pill (subtle, non-intrusive) -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <c:StatusDot
                            x:Name="HeaderConnectionDot"
                            Color="{ThemeResource StudioSecondaryOpacity45Brush}" />
                        <TextBlock
                            x:Name="HeaderTelemetryText"
                            MaxWidth="460"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource StudioTextSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Unified Borderless Fluent 2 Title Bar Actions -->
            <StackPanel
                Grid.Column="1"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">

                <!-- Prompt Templates Menu -->
                <Button
                    Style="{StaticResource StudioTitleBarButtonStyle}"
                    ToolTipService.ToolTip="{loc:L Zh='填入当前模型精选提示词模板', En='Insert curated prompt templates for the active model'}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12.5" Glyph="&#xE8FD;" />
                        <TextBlock FontSize="12" Text="{loc:L Zh='模板', En='Templates'}" />
                        <FontIcon FontSize="8.5" Glyph="&#xE70D;" Opacity="0.65" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="TemplatesMenuFlyout" Opening="TemplatesMenuFlyout_Opening" Placement="BottomEdgeAlignedLeft" />
                    </Button.Flyout>
                </Button>

                <!-- Local Output Folder -->
                <Button
                    Click="OpenOutputFolderButton_Click"
                    Style="{StaticResource StudioTitleBarButtonStyle}"
                    ToolTipService.ToolTip="{loc:L Zh='打开本地保存的视频与图像文件夹', En='Open local folder for saved videos &amp; images'}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12.5" Glyph="&#xE8B7;" />
                        <TextBlock FontSize="12" Text="{loc:L Zh='输出目录', En='Outputs'}" />
                    </StackPanel>
                </Button>

                <!-- Onboarding Guide -->
                <Button
                    Click="OpenGuideButton_Click"
                    Style="{StaticResource StudioTitleBarButtonStyle}"
                    ToolTipService.ToolTip="{loc:L Zh='打开 EasyColab 新手引导与使用指南 (F1)', En='Open EasyColab quick start &amp; user guide (F1)'}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            FontSize="12.5"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE82D;" />
                        <TextBlock FontSize="12" Text="{loc:L Zh='引导', En='Guide'}" />
                    </StackPanel>
                </Button>

                <Border
                    Width="1"
                    Height="14"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource StudioSplitDividerBrush}" />

                <!-- Language Switch -->
                <Button
                    x:Name="LanguageToggleButton"
                    Click="LanguageToggleButton_Click"
                    Style="{StaticResource StudioTitleBarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon FontSize="12" Glyph="&#xE774;" />
                        <TextBlock
                            x:Name="LanguageToggleLabel"
                            FontSize="11.5"
                            FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Theme Switch (System / Light / Dark) -->
                <Button
                    x:Name="ThemeToggleButton"
                    Padding="7,0"
                    Click="ThemeToggleButton_Click"
                    Style="{StaticResource StudioTitleBarButtonStyle}">
                    <FontIcon x:Name="ThemeToggleIcon" FontSize="13" Glyph="&#xE793;" />
                </Button>

                <!-- Toggle Right Log Panel -->
                <Button
                    x:Name="ToggleLogPanelButton"
                    Padding="7,0"
                    Click="ToggleLogPanelButton_Click"
                    Style="{StaticResource StudioTitleBarButtonStyle}">
                    <FontIcon
                        x:Name="ToggleLogPanelIcon"
                        FontSize="13"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE90C;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main 3-Column Fluent 2 Layered Body -->
        <Grid
            x:Name="ShellGrid"
            Grid.Row="1"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="346" />
                <ColumnDefinition Width="*" MinWidth="500" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 1. Left Control Sidebar (transparent to reveal Mica Alt behind cards) -->
            <views:SidebarPanel
                x:Name="LeftSidebarPanel"
                Grid.Column="0"
                Background="Transparent" />

            <!-- 2. Center Main Workspace (elevated Fluent 2 rounded layer) -->
            <Border
                Grid.Column="1"
                Margin="0,0,8,8"
                Background="{ThemeResource StudioWorkspaceCanvasBrush}"
                BorderBrush="{ThemeResource StudioCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ws:WorkspacePanel x:Name="CenterWorkspacePanel" />
            </Border>

            <!-- 3. Right Collapsible Run Log Surface (elevated Fluent 2 rounded layer) -->
            <Border
                x:Name="RightLogColumnHost"
                Grid.Column="2"
                Width="344"
                Margin="0,0,8,8"
                Background="{ThemeResource StudioLogPanelBackgroundBrush}"
                BorderBrush="{ThemeResource StudioCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Clean Embedded Log Header -->
                    <Grid
                        Grid.Row="0"
                        Padding="12,0,8,0"
                        ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="12.5"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE756;" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StudioTextPrimaryBrush}"
                            Text="{loc:L Zh='运行日志', En='Run Logs'}" />

                        <!-- Live Streaming / Line Count Badge -->
                        <Border
                            Grid.Column="2"
                            Height="20"
                            Padding="7,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse
                                    x:Name="LogLiveDot"
                                    Width="5.5"
                                    Height="5.5"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource StudioSecondaryOpacity45Brush}" />
                                <TextBlock
                                    x:Name="LogLiveBadgeText"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource StudioMonoFont}"
                                    FontSize="10.5"
                                    Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Copy All Logs -->
                        <Button
                            Grid.Column="4"
                            Height="26"
                            MinWidth="26"
                            Padding="5,0"
                            Click="CopyLogsButton_Click"
                            Style="{StaticResource StudioTitleBarButtonStyle}"
                            ToolTipService.ToolTip="{loc:L Zh='复制全部日志', En='Copy all logs'}">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                Glyph="&#xE8C8;" />
                        </Button>

                        <!-- Clear Logs -->
                        <Button
                            Grid.Column="5"
                            Height="26"
                            MinWidth="26"
                            Padding="5,0"
                            Click="ClearLogsButton_Click"
                            Style="{StaticResource StudioTitleBarButtonStyle}"
                            ToolTipService.ToolTip="{loc:L Zh='清空当前日志', En='Clear console logs'}">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                Glyph="&#xE74D;" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Background="{ThemeResource StudioSplitDividerBrush}" />

                    <views:RightLogPanel x:Name="LogPanelView" Grid.Row="2" />
                </Grid>
            </Border>
        </Grid>

        <!-- Topmost Modal Overlays (spanning full window including titlebar) -->
        <dialogs:ColabGuideDialog Grid.RowSpan="2" />
        <dialogs:AddCustomHFModelDialog Grid.RowSpan="2" />
        <dialogs:HFModelDetailOverlay Grid.RowSpan="2" />
    </Grid>
</UserControl>
