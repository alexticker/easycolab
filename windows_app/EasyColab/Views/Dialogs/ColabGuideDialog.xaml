<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EasyColab.Views.Dialogs.ColabGuideDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:EasyColab.Controls"
    xmlns:loc="using:EasyColab.Localization"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Visibility="Collapsed">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <UserControl.Resources>
        <Style x:Key="GuideNavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="GuideInfoCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource StudioDialogCardFillBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource StudioCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="GuideNumberBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{ThemeResource StudioSystemAccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>

        <Style x:Key="GuideCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{ThemeResource StudioTextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="GuideCardDetailStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource StudioTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- Dark Scrim Backdrop -->
        <Border
            x:Name="ScrimBorder"
            Background="#88000000"
            PointerPressed="OnScrimPointerPressed" />

        <!-- Centered Elevated Dialog Card (~920x640, shrinks cleanly on smaller windows) -->
        <Border
            MaxWidth="920"
            MaxHeight="640"
            Margin="28"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{ThemeResource StudioDialogSurfaceBrush}"
            BorderBrush="{ThemeResource StudioCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="268" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Step Navigation Pane -->
                <Border
                    Grid.Column="0"
                    Background="{ThemeResource StudioDialogSidebarBrush}"
                    CornerRadius="11,0,0,11">
                <Grid
                    Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand Header -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,18"
                        Orientation="Horizontal"
                        Spacing="9">
                        <Border
                            Width="30"
                            Height="30"
                            VerticalAlignment="Center"
                            CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#FF1A47AD" />
                                    <GradientStop Offset="1" Color="#FF297AEB" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="White"
                                Glyph="&#xE735;" />
                        </Border>

                        <StackPanel VerticalAlignment="Center" Spacing="1.5">
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                Text="{loc:L Zh='EasyColab 指南', En='EasyColab Guide'}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                Text="{loc:L Zh='3 分钟零基础快速上手', En='Get started in 3 minutes'}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 4 Step Navigation Items -->
                    <StackPanel
                        x:Name="NavButtonsPanel"
                        Grid.Row="1"
                        Spacing="7">
                        <!-- Step 0 -->
                        <Button
                            x:Name="NavBtn0"
                            Click="OnNavStepClick"
                            Style="{StaticResource GuideNavButtonStyle}"
                            Tag="0">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    x:Name="NavIcon0"
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    Glyph="&#xE945;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        x:Name="NavTitle0"
                                        FontSize="12.5"
                                        Text="{loc:L Zh='第 1 步 · 连接云端 96GB 显卡', En='Step 1 · Connect Cloud 96GB GPU'}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                        Text="{loc:L Zh='绑定账号 · 一键唤醒 G4 实例', En='Bind Google · 1-Click Wake G4 VM'}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Step 1 -->
                        <Button
                            x:Name="NavBtn1"
                            Click="OnNavStepClick"
                            Style="{StaticResource GuideNavButtonStyle}"
                            Tag="1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    x:Name="NavIcon1"
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    Glyph="&#xE81E;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        x:Name="NavTitle1"
                                        FontSize="12.5"
                                        Text="{loc:L Zh='第 2 步 · 下载与加载开源模型', En='Step 2 · Download &amp; Load Open Models'}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                        Text="{loc:L Zh='云盘永久保存 · 大内存热备共驻', En='Drive Persistence · Co-Resident VRAM'}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Step 2 -->
                        <Button
                            x:Name="NavBtn2"
                            Click="OnNavStepClick"
                            Style="{StaticResource GuideNavButtonStyle}"
                            Tag="2">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    x:Name="NavIcon2"
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    Glyph="&#xE734;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        x:Name="NavTitle2"
                                        FontSize="12.5"
                                        Text="{loc:L Zh='第 3 步 · 四大模式快速上手', En='Step 3 · 4 Creative Studio Modes'}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                        Text="{loc:L Zh='有声视频 · ComfyUI · 对话 · 生图', En='Video+Audio · ComfyUI · Chat · Image'}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Step 3 -->
                        <Button
                            x:Name="NavBtn3"
                            Click="OnNavStepClick"
                            Style="{StaticResource GuideNavButtonStyle}"
                            Tag="3">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    x:Name="NavIcon3"
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    Glyph="&#xEA18;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        x:Name="NavTitle3"
                                        FontSize="12.5"
                                        Text="{loc:L Zh='第 4 步 · 作品保存与省额度秘籍', En='Step 4 · Output Saving &amp; CU Tips'}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                        Text="{loc:L Zh='自动回传本地 · 防忘关机自动释放', En='Auto Local Sync · Idle Auto-Release'}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Bottom-Left Live Environment Status Card -->
                    <Border
                        Grid.Row="3"
                        Padding="11"
                        Background="{ThemeResource StudioDialogCardFillBrush}"
                        BorderBrush="{ThemeResource StudioCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                        <StackPanel Spacing="7">
                            <TextBlock
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                Text="{loc:L Zh='当前环境状态', En='Environment Status'}" />

                            <Grid ColumnSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <c:StatusDot x:Name="AccountStatusDot" Grid.Column="0" />
                                <TextBlock
                                    x:Name="AccountStatusText"
                                    Grid.Column="1"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Grid ColumnSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <c:StatusDot x:Name="GpuStatusDot" Grid.Column="0" />
                                <TextBlock
                                    x:Name="GpuStatusText"
                                    Grid.Column="1"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                </Border>

                <!-- Vertical Divider -->
                <Rectangle Grid.Column="1" Fill="{ThemeResource StudioSplitDividerBrush}" />

                <!-- Right Main Guide Content Pane -->
                <Grid Grid.Column="2" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Header -->
                    <Grid Grid.Row="0" Padding="24,20,24,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="5">
                            <Border
                                Padding="8,2.5"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource StudioAccentBlueFillBrush}"
                                CornerRadius="10">
                                <TextBlock
                                    x:Name="StepBadgeText"
                                    FontFamily="{StaticResource StudioMonoFont}"
                                    FontSize="10.5"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource StudioAccentBlueBrush}"
                                    Text="STEP 01 / 04" />
                            </Border>

                            <TextBlock
                                x:Name="StepTitleText"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{ThemeResource StudioTextPrimaryBrush}" />

                            <TextBlock
                                x:Name="StepSubtitleText"
                                FontSize="12.5"
                                Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Spacing="10">
                            <!-- Language Toggle Pill -->
                            <Button
                                x:Name="LangToggleButton"
                                Click="OnToggleLanguageClick"
                                Style="{StaticResource StudioPlainButtonStyle}">
                                <Border
                                    Padding="9,4"
                                    Background="{ThemeResource StudioAccentBlueFillBrush}"
                                    BorderBrush="{ThemeResource StudioAccentBlueBrush}"
                                    BorderThickness="0.8"
                                    CornerRadius="10">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            FontSize="11"
                                            Foreground="{ThemeResource StudioAccentBlueBrush}"
                                            Glyph="&#xE774;" />
                                        <TextBlock
                                            x:Name="LangToggleLabel"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource StudioAccentBlueBrush}" />
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- Close Button -->
                            <Button
                                Click="OnCloseClick"
                                Style="{StaticResource StudioPlainButtonStyle}"
                                ToolTipService.ToolTip="{loc:L Zh='关闭引导页', En='Close Guide'}">
                                <Border
                                    Width="26"
                                    Height="26"
                                    Background="{ThemeResource StudioPrimaryOpacity06Brush}"
                                    CornerRadius="13">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                        Glyph="&#xE711;" />
                                </Border>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Rectangle Grid.Row="1" Fill="{ThemeResource StudioSplitDividerBrush}" />

                    <!-- Step Content Scroll Area -->
                    <ScrollViewer
                        x:Name="StepScrollViewer"
                        Grid.Row="2"
                        VerticalScrollBarVisibility="Auto">
                        <Grid Padding="22">
                            <!-- STEP 1: Connect Cloud GPU -->
                            <StackPanel x:Name="Step0Panel" Spacing="12">
                                <!-- Card 1 -->
                                <Border Style="{StaticResource GuideInfoCardBorderStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource GuideNumberBadgeStyle}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12.5"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="1" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock
                                                Style="{StaticResource GuideCardTitleStyle}"
                                                Text="{loc:L Zh='绑定 Google 账号（仅首次需要一次）', En='Bind Your Google Account (One-Time Setup)'}" />
                                            <TextBlock
                                                x:Name="Step1Card1Detail"
                                                Style="{StaticResource GuideCardDetailStyle}" />

                                            <Button
                                                x:Name="BindNowButton"
                                                Padding="11,5"
                                                HorizontalAlignment="Left"
                                                Click="OnBindGoogleNowClick"
                                                Style="{ThemeResource StudioPrimaryButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontSize="12" Glyph="&#xE77B;" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Text="{loc:L Zh='现在去绑定 Google 账号', En='Bind Google Account Now'}" />
                                                </StackPanel>
                                            </Button>

                                            <StackPanel
                                                x:Name="AlreadyBoundBadge"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                Visibility="Collapsed">
                                                <FontIcon
                                                    FontSize="13"
                                                    Foreground="{ThemeResource StudioAccentGreenBrush}"
                                                    Glyph="&#xE930;" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource StudioAccentGreenBrush}"
                                                    Text="{loc:L Zh='你的 Google 账号已完成绑定', En='Your Google account is connected'}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Card 2 -->
                                <Border Style="{StaticResource GuideInfoCardBorderStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource GuideNumberBadgeStyle}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12.5"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="2" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock
                                                x:Name="Step1Card2Title"
                                                Style="{StaticResource GuideCardTitleStyle}" />
                                            <TextBlock
                                                x:Name="Step1Card2Detail"
                                                Style="{StaticResource GuideCardDetailStyle}" />

                                            <Button
                                                x:Name="WakeG4NowButton"
                                                Padding="11,5"
                                                HorizontalAlignment="Left"
                                                Click="OnWakeG4NowClick"
                                                Style="{ThemeResource StudioPrimaryButtonStyle}"
                                                Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontSize="12" Glyph="&#xE945;" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Text="{loc:L Zh='立即一键唤醒 G4 并部署', En='Wake G4 &amp; Deploy Now'}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Card 3 -->
                                <Border Style="{StaticResource GuideInfoCardBorderStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource GuideNumberBadgeStyle}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12.5"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="3" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock
                                                Style="{StaticResource GuideCardTitleStyle}"
                                                Text="{loc:L Zh='备选方案：通过 Google Colab 网页端手动运行笔记本', En='Alternative: Run the Notebook Manually in Google Colab Web'}" />
                                            <TextBlock
                                                x:Name="Step1Card3Detail"
                                                Style="{StaticResource GuideCardDetailStyle}" />

                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Button Padding="10,5" Click="OnRevealNotebookClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon FontSize="12" Glyph="&#xE8B7;" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Text="{loc:L Zh='导出 / 定位 .ipynb 笔记本', En='Reveal .ipynb Notebook'}" />
                                                    </StackPanel>
                                                </Button>

                                                <Button Padding="10,5" Click="OnOpenColabWebClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon FontSize="12" Glyph="&#xE774;" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Text="{loc:L Zh='打开 Google Colab 官网', En='Open Google Colab Web'}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- STEP 2: Download & Load Models -->
                            <StackPanel
                                x:Name="Step1Panel"
                                Spacing="12"
                                Visibility="Collapsed">
                                <!-- Card 1 -->
                                <Border Style="{StaticResource GuideInfoCardBorderStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource GuideNumberBadgeStyle}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12.5"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="1" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock
                                                x:Name="Step2Card1Title"
                                                Style="{StaticResource GuideCardTitleStyle}" />
                                            <TextBlock
                                                x:Name="Step2Card1Detail"
                                                Style="{StaticResource GuideCardDetailStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Card 2 -->
                                <Border Style="{StaticResource GuideInfoCardBorderStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource GuideNumberBadgeStyle}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12.5"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="2" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock
                                                x:Name="Step2Card2Title"
                                                Style="{StaticResource GuideCardTitleStyle}" />
                                            <TextBlock
                                                x:Name="Step2Card2Detail"
                                                Style="{StaticResource GuideCardDetailStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Card 3 -->
                                <Border Style="{StaticResource GuideInfoCardBorderStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource GuideNumberBadgeStyle}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12.5"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="3" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock
                                                Style="{StaticResource GuideCardTitleStyle}"
                                                Text="{loc:L Zh='右侧实时日志与折线图监控', En='Live Telemetry Charts &amp; Real-Time Run Logs'}" />
                                            <TextBlock
                                                Style="{StaticResource GuideCardDetailStyle}"
                                                Text="{loc:L Zh='左下角算力卡片提供显存、系统内存与磁盘折线走势图（点切换按钮可合并/展开三线对比）；右侧独立面板实时滚动下载速率、采样步进度与预计剩余时间。', En='The left compute card plots live VRAM, System RAM, and Disk curves (toggle between Split and Combined views), while the collapsible right log panel streams live download speeds, sampling steps, and ETA.'}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- STEP 3: 4 Creative Studio Modes -->
                            <StackPanel
                                x:Name="Step2Panel"
                                Spacing="12"
                                Visibility="Collapsed">
                                <!-- Card A -->
                                <Border Style="{StaticResource GuideInfoCardBorderStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource GuideNumberBadgeStyle}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12.5"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="A" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock
                                                Style="{StaticResource GuideCardTitleStyle}"
                                                Text="{loc:L Zh='MiniMax-H3 · 4～15 秒电影级原生有声视频', En='MiniMax-H3 · 4–15s Cinematic Video with Native Stereo Audio'}" />
                                            <TextBlock
                                                x:Name="Step3CardADetail"
                                                Style="{StaticResource GuideCardDetailStyle}" />
                                            <Button
                                                Padding="10,5"
                                                HorizontalAlignment="Left"
                                                Click="OnJumpToModelClick"
                                                Tag="minimax_h3">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontSize="12" Glyph="&#xE714;" />
                                                    <TextBlock
                                                        FontSize="12"
