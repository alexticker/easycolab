<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EasyColab.Views.Dialogs.HFModelDetailOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:EasyColab.Controls"
    xmlns:loc="using:EasyColab.Localization"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Visibility="Collapsed">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <UserControl.Resources>
        <Style x:Key="StatBoxBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{ThemeResource StudioPrimaryOpacity06Brush}" />
        </Style>

        <Style x:Key="StatBoxLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{ThemeResource StudioTextSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="StatBoxValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{ThemeResource StudioTextPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- Dark Scrim Backdrop -->
        <Border
            x:Name="ScrimBorder"
            Background="#88000000"
            PointerPressed="OnScrimPointerPressed" />

        <!-- Centered Elevated Detail Card (~860x700, renders above AddCustomHFModelDialog) -->
        <Border
            MaxWidth="860"
            MaxHeight="700"
            Margin="28"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{ThemeResource StudioDialogSurfaceBrush}"
            BorderBrush="{ThemeResource StudioCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">

            <Grid>
                <!-- Loading State -->
                <StackPanel
                    x:Name="LoadingPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14"
                    Visibility="Collapsed">
                    <ProgressRing
                        x:Name="LoadingSpinner"
                        Width="36"
                        Height="36"
                        HorizontalAlignment="Center"
                        IsActive="False" />
                    <TextBlock
                        MaxWidth="520"
                        HorizontalAlignment="Center"
                        FontSize="12.5"
                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                        Text="{loc:L Zh='正在从 HuggingFace Hub 解析模型详情、张量参数与分片体积...', En='Inspecting HuggingFace model metadata, tensor parameters &amp; weight shards...'}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        Padding="14,6"
                        HorizontalAlignment="Center"
                        Click="OnCloseOverlayClick"
                        Content="{loc:L Zh='返回模型列表', En='Back to List'}" />
                </StackPanel>

                <!-- Empty / Error Fallback State -->
                <StackPanel
                    x:Name="EmptyStatePanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="28"
                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                        Glyph="&#xE7BA;" />
                    <TextBlock
                        MaxWidth="480"
                        HorizontalAlignment="Center"
                        FontSize="12.5"
                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                        Text="{loc:L Zh='无法获取该 HuggingFace 模型详情，请检查仓库 ID、网络连接或 HF Token。', En='Failed to load HuggingFace model details. Check Repo ID, network, or HF Token.'}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        Padding="14,6"
                        HorizontalAlignment="Center"
                        Click="OnCloseOverlayClick"
                        Content="{loc:L Zh='返回模型列表', En='Back to List'}" />
                </StackPanel>

                <!-- Loaded Detail State -->
                <Grid x:Name="DetailRootGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Padding="18,16,18,12" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <!-- Title Row: Back + Lock + Name + Param Badge + Deploy Badge -->
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Button
                                    Click="OnCloseOverlayClick"
                                    Style="{StaticResource StudioPlainButtonStyle}">
                                    <Border
                                        Padding="8,3.5"
                                        Background="{ThemeResource StudioPrimaryOpacity06Brush}"
                                        CornerRadius="10">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon
                                                FontSize="10.5"
                                                Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                                Glyph="&#xE76B;" />
                                            <TextBlock
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                                Text="{loc:L Zh='返回', En='Back'}" />
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <FontIcon
                                    x:Name="HeaderGatedLockIcon"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    Foreground="{ThemeResource StudioAccentOrangeBrush}"
                                    Glyph="&#xE72E;"
                                    ToolTipService.ToolTip="{loc:L Zh='受限模型 (Gated Repo)：需填写 HF Token 并同意协议', En='Gated repo: requires HF Token &amp; license agreement'}"
                                    Visibility="Collapsed" />

                                <TextBlock
                                    x:Name="HeaderModelNameText"
                                    MaxWidth="300"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                    TextTrimming="CharacterEllipsis" />

                                <Border
                                    x:Name="HeaderParamBadge"
                                    Padding="7,2"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource StudioAccentPurpleFillBrush}"
                                    CornerRadius="10"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="HeaderParamText"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{ThemeResource StudioAccentPurpleBrush}" />
                                </Border>

                                <Border
                                    x:Name="HeaderDeployBadge"
                                    Padding="8,2.5"
                                    VerticalAlignment="Center"
                                    CornerRadius="10">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Ellipse
                                            x:Name="HeaderDeployDot"
                                            Width="6"
                                            Height="6"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            x:Name="HeaderDeployText"
                                            FontSize="10.5"
                                            FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Metadata Sub-row: RepoId, Likes, Downloads, Updated -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock
                                    x:Name="HeaderRepoIdText"
                                    FontFamily="{StaticResource StudioMonoFont}"
                                    FontSize="11"
                                    Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                    IsTextSelectionEnabled="True" />

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="9.5"
                                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                        Glyph="&#xEB52;" />
                                    <TextBlock
                                        x:Name="HeaderLikesText"
                                        FontFamily="{StaticResource StudioMonoFont}"
                                        FontSize="11"
                                        Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="9.5"
                                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                        Glyph="&#xE896;" />
                                    <TextBlock
                                        x:Name="HeaderDownloadsText"
                                        FontFamily="{StaticResource StudioMonoFont}"
                                        FontSize="11"
                                        Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                </StackPanel>

                                <TextBlock
                                    x:Name="HeaderUpdatedText"
                                    FontFamily="{StaticResource StudioMonoFont}"
                                    FontSize="11"
                                    Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Padding="10,5" Click="OnOpenOnHfClick">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon FontSize="11.5" Glyph="&#xE774;" />
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Text="{loc:L Zh='打开 HF 主页', En='Open on HF'}" />
                                </StackPanel>
                            </Button>

                            <Button
                                Click="OnCloseOverlayClick"
                                Style="{StaticResource StudioPlainButtonStyle}"
                                ToolTipService.ToolTip="{loc:L Zh='关闭', En='Close'}">
                                <Border
                                    Width="26"
                                    Height="26"
                                    Background="{ThemeResource StudioPrimaryOpacity06Brush}"
                                    CornerRadius="13">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                        Glyph="&#xE711;" />
                                </Border>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Rectangle Grid.Row="1" Fill="{ThemeResource StudioSplitDividerBrush}" />

                    <!-- Main Body -->
                    <Grid Grid.Row="2" Padding="18,14" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 4 Stat Boxes -->
                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Stat 1: Params / Repo Size -->
                            <Border Grid.Column="0" Style="{StaticResource StatBoxBorderStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource StatBoxLabelStyle}"
                                        Text="{loc:L Zh='参数量 / 总存储', En='Params / Repo Size'}" />
                                    <TextBlock x:Name="StatParamsText" Style="{StaticResource StatBoxValueStyle}" />
                                </StackPanel>
                            </Border>

                            <!-- Stat 2: Arch / Context -->
                            <Border Grid.Column="1" Style="{StaticResource StatBoxBorderStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource StatBoxLabelStyle}"
                                        Text="{loc:L Zh='模型架构 / 上下文', En='Arch / Context'}" />
                                    <TextBlock x:Name="StatArchText" Style="{StaticResource StatBoxValueStyle}" />
                                </StackPanel>
                            </Border>

                            <!-- Stat 3: License -->
                            <Border Grid.Column="2" Style="{StaticResource StatBoxBorderStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource StatBoxLabelStyle}"
                                        Text="{loc:L Zh='开源协议 (License)', En='License'}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon
                                            x:Name="StatLicenseLockIcon"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{ThemeResource StudioAccentOrangeBrush}"
                                            Glyph="&#xE72E;"
                                            Visibility="Collapsed" />
                                        <TextBlock x:Name="StatLicenseText" Style="{StaticResource StatBoxValueStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Stat 4: Base Model -->
                            <Border Grid.Column="3" Style="{StaticResource StatBoxBorderStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource StatBoxLabelStyle}"
                                        Text="{loc:L Zh='基座模型 (Base)', En='Base Model'}" />
                                    <TextBlock x:Name="StatBaseModelText" Style="{StaticResource StatBoxValueStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Weight & Quant Shards Section -->
                        <Grid Grid.Row="1" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource StudioAccentBlueBrush}"
                                    Glyph="&#xE7B8;" />
                                <TextBlock
                                    x:Name="WeightSectionTitleText"
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                            </StackPanel>

                            <TextBlock
                                x:Name="NoWeightsText"
                                Grid.Row="1"
                                Padding="2,6"
                                FontSize="11.5"
                                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                Text="{loc:L Zh='该仓库未列出直接的 .gguf / .safetensors 顶层权重文件，添加后将按完整仓库拉取。', En='No top-level .gguf / .safetensors files listed; full snapshot will be downloaded.'}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />

                            <Border
                                x:Name="WeightFilesContainer"
                                Grid.Row="1"
                                Background="{ThemeResource StudioInputFillBrush}"
                                BorderBrush="{ThemeResource StudioCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ScrollViewer Padding="6" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="WeightFilesStack" Spacing="4" />
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- Model Card README Excerpt Section -->
                        <StackPanel
                            x:Name="ReadmeSectionPanel"
                            Grid.Row="2"
                            Spacing="6"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource StudioAccentBlueBrush}"
                                    Glyph="&#xE8A5;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                    Text="{loc:L Zh='模型卡说明摘要 (Model Card Excerpt)', En='Model Card Excerpt'}" />
                            </StackPanel>

                            <Border
                                Height="150"
                                Background="{ThemeResource StudioInputFillBrush}"
                                BorderBrush="{ThemeResource StudioCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ScrollViewer Padding="10" VerticalScrollBarVisibility="Auto">
                                    <c:HFMarkdownExcerptView x:Name="ReadmeViewer" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Rectangle Grid.Row="3" Fill="{ThemeResource StudioSplitDividerBrush}" />

                    <!-- Footer -->
                    <Grid Grid.Row="4" Padding="18,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Padding="16,7"
                            Click="OnCloseOverlayClick">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon FontSize="11.5" Glyph="&#xE76B;" />
                                <TextBlock
                                    FontSize="12.5"
                                    Text="{loc:L Zh='返回配置表单', En='Back to Form'}" />
                            </StackPanel>
                        </Button>

                        <Button
                            Grid.Column="2"
                            Padding="18,7"
                            Click="OnUseModelClick"
                            Style="{ThemeResource StudioPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Glyph="&#xE930;" />
                                <TextBlock
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Text="{loc:L Zh='选用此模型并返回', En='Use This Model'}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
