<?xml version="1.0" encoding="utf-8"?>
<!--
  EasyColab Studio Theme — Native Windows 11 Fluent 2 design tokens.
  Uses translucent Mica-compatible layers, official CardStroke/CardBackground opacities,
  and native WinUI 3 DefaultButtonStyle / AccentButtonStyle / Subtle button chromes.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyColab.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Transparent sidebar reveals Mica Alt; translucent cards & workspace layers float cleanly above it -->
            <SolidColorBrush x:Key="StudioSidebarBackgroundBrush" Color="#00000000" />
            <SolidColorBrush x:Key="StudioSidebarCardFillBrush" Color="#0EFFFFFF" />
            <SolidColorBrush x:Key="StudioWorkspaceCanvasBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="StudioWorkspaceCardFillBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="StudioLogHeaderBackgroundBrush" Color="#00000000" />
            <SolidColorBrush x:Key="StudioLogPanelBackgroundBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="StudioLogTerminalFillBrush" Color="#FF111318" />
            <SolidColorBrush x:Key="StudioSplitDividerBrush" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="StudioCardBorderBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="StudioInputFillBrush" Color="#0CFFFFFF" />
            <SolidColorBrush x:Key="StudioTextPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="StudioTextSecondaryBrush" Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="StudioTextTertiaryBrush" Color="#8BFFFFFF" />

            <!-- Fluent 2 semantic accents (Dark) — primary accent follows Windows 11 system accent -->
            <SolidColorBrush x:Key="StudioAccentBlueBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="StudioAccentBlueFillBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.15" />
            <SolidColorBrush x:Key="StudioAccentBlueBorderBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.38" />
            <SolidColorBrush x:Key="StudioAccentGreenBrush" Color="#FF6CCB5F" />
            <SolidColorBrush x:Key="StudioAccentGreenFillBrush" Color="#226CCB5F" />
            <SolidColorBrush x:Key="StudioAccentOrangeBrush" Color="#FFFCE100" />
            <SolidColorBrush x:Key="StudioAccentOrangeFillBrush" Color="#22FCE100" />
            <SolidColorBrush x:Key="StudioAccentRedBrush" Color="#FFFF99A4" />
            <SolidColorBrush x:Key="StudioAccentRedFillBrush" Color="#24FF99A4" />
            <SolidColorBrush x:Key="StudioAccentPurpleBrush" Color="#FFC49BFF" />
            <SolidColorBrush x:Key="StudioAccentPurpleFillBrush" Color="#22C49BFF" />

            <SolidColorBrush x:Key="StudioSystemAccentBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="StudioSystemGreenBrush" Color="#FF6CCB5F" />
            <SolidColorBrush x:Key="StudioSystemOrangeBrush" Color="#FFFFB900" />
            <SolidColorBrush x:Key="StudioSystemRedBrush" Color="#FFFF99A4" />
            <SolidColorBrush x:Key="StudioSecondaryOpacity45Brush" Color="#44FFFFFF" />
            <SolidColorBrush x:Key="StudioSecondaryOpacity50Brush" Color="#50FFFFFF" />
            <SolidColorBrush x:Key="StudioPrimaryOpacity06Brush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="StudioPrimaryOpacity32Brush" Color="#52FFFFFF" />
            <SolidColorBrush x:Key="StudioTelemetryPlotFillBrush" Color="#33000000" />
            <SolidColorBrush x:Key="StudioTelemetryCombinedPlotFillBrush" Color="#38000000" />
            <SolidColorBrush x:Key="StudioTelemetryGridLineBrush" Color="#14FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Transparent sidebar reveals Mica Alt; translucent Fluent 2 layers float cleanly above it -->
            <SolidColorBrush x:Key="StudioSidebarBackgroundBrush" Color="#00000000" />
            <SolidColorBrush x:Key="StudioSidebarCardFillBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="StudioWorkspaceCanvasBrush" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="StudioWorkspaceCardFillBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="StudioLogHeaderBackgroundBrush" Color="#00000000" />
            <SolidColorBrush x:Key="StudioLogPanelBackgroundBrush" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="StudioLogTerminalFillBrush" Color="#FF13161C" />
            <SolidColorBrush x:Key="StudioSplitDividerBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="StudioCardBorderBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="StudioInputFillBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="StudioTextPrimaryBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="StudioTextSecondaryBrush" Color="#9E000000" />
            <SolidColorBrush x:Key="StudioTextTertiaryBrush" Color="#72000000" />

            <!-- Fluent 2 semantic accents (Light) — primary accent follows Windows 11 system accent -->
            <SolidColorBrush x:Key="StudioAccentBlueBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="StudioAccentBlueFillBrush" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.11" />
            <SolidColorBrush x:Key="StudioAccentBlueBorderBrush" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.32" />
            <SolidColorBrush x:Key="StudioAccentGreenBrush" Color="#FF0F7B0F" />
            <SolidColorBrush x:Key="StudioAccentGreenFillBrush" Color="#180F7B0F" />
            <SolidColorBrush x:Key="StudioAccentOrangeBrush" Color="#FF9D5D00" />
            <SolidColorBrush x:Key="StudioAccentOrangeFillBrush" Color="#1A9D5D00" />
            <SolidColorBrush x:Key="StudioAccentRedBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="StudioAccentRedFillBrush" Color="#18C42B1C" />
            <SolidColorBrush x:Key="StudioAccentPurpleBrush" Color="#FF6B38B8" />
            <SolidColorBrush x:Key="StudioAccentPurpleFillBrush" Color="#186B38B8" />

            <SolidColorBrush x:Key="StudioSystemAccentBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="StudioSystemGreenBrush" Color="#FF0F7B0F" />
            <SolidColorBrush x:Key="StudioSystemOrangeBrush" Color="#FF9D5D00" />
            <SolidColorBrush x:Key="StudioSystemRedBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="StudioSecondaryOpacity45Brush" Color="#40000000" />
            <SolidColorBrush x:Key="StudioSecondaryOpacity50Brush" Color="#48000000" />
            <SolidColorBrush x:Key="StudioPrimaryOpacity06Brush" Color="#0A000000" />
            <SolidColorBrush x:Key="StudioPrimaryOpacity32Brush" Color="#48000000" />
            <SolidColorBrush x:Key="StudioTelemetryPlotFillBrush" Color="#70FFFFFF" />
            <SolidColorBrush x:Key="StudioTelemetryCombinedPlotFillBrush" Color="#70FFFFFF" />
            <SolidColorBrush x:Key="StudioTelemetryGridLineBrush" Color="#0F000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Terminal text is always light (terminal fill is dark in both themes) -->
    <SolidColorBrush x:Key="StudioTerminalTextBrush" Color="#FFD4D8E0" />
    <FontFamily x:Key="StudioMonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Allow compact 28px inputs without clipping the bottom border of TextBox/PasswordBox -->
    <x:Double x:Key="TextControlThemeMinHeight">26</x:Double>
    <Thickness x:Key="TextControlThemePadding">8,4,8,4</Thickness>

    <!-- Shared card container styles (Fluent 2 8px radius, crisp 1px CardStroke) -->
    <Style x:Key="StudioSidebarCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource StudioSidebarCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StudioCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="StudioWorkspaceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource StudioWorkspaceCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StudioCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="StudioCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{ThemeResource StudioTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="StudioSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource StudioTextPrimaryBrush}" />
    </Style>

    <!-- Plain button: content only, no chrome (used by interactive card rows) -->
    <Style x:Key="StudioPlainButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Background="{TemplateBinding Background}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Native WinUI 3 Fluent 2 Accent Button (follows Windows 11 system accent & elevation) -->
    <Style x:Key="StudioPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Native WinUI 3 Fluent 2 Standard Button (preserves ControlElevationBorderBrush & Fluent animations) -->
    <Style x:Key="StudioSurfaceButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- Native WinUI 3 Subtle TitleBar / Toolbar Button (transparent at rest, Fluent subtle plate on hover) -->
    <Style x:Key="StudioTitleBarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="RootBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Controls/Cards.cs: SidebarCard (Fluent 2 translucent card floating on Mica) -->
    <Style TargetType="controls:SidebarCard">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="14,12,14,14" />
        <Setter Property="Background" Value="{ThemeResource StudioSidebarCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StudioCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SidebarCard">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="{TemplateBinding Icon}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                    Text="{TemplateBinding Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <Border
                                    x:Name="BadgeCapsule"
                                    Grid.Column="2"
                                    Margin="6,0,0,0"
                                    Padding="7,2"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        FontSize="10.5"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                        Text="{TemplateBinding Badge}" />
                                </Border>
                            </Grid>
                            <ContentPresenter
                                Grid.Row="1"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Controls/Cards.cs: WorkspaceCard (Fluent 2 elevated card inside workspace layer) -->
    <Style TargetType="controls:WorkspaceCard">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="16,14,16,16" />
        <Setter Property="Background" Value="{ThemeResource StudioWorkspaceCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StudioCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:WorkspaceCard">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    x:Name="IconGlyph"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="13.5"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="{TemplateBinding Icon}"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontSize="13.5"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                        Text="{TemplateBinding Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="SubtitleText"
                                        FontSize="11"
                                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                        Text="{TemplateBinding Subtitle}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                </StackPanel>
                                <ContentPresenter
                                    x:Name="TrailingPresenter"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Trailing}"
                                    Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter
                                Grid.Row="1"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
