<?xml version="1.0" encoding="utf-8"?>
<!--
  EasyColab Studio palette — 1:1 port of macOS `StudioPalette` (ModelsAndCatalogs.swift).
  Every brush is theme-aware: use {ThemeResource Studio...Brush} in XAML so that switching
  RequestedTheme on the root element re-evaluates colours instantly without rebuilding UI.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EasyColab.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="StudioSidebarBackgroundBrush" Color="#FF1C1F25" />
            <SolidColorBrush x:Key="StudioSidebarCardFillBrush" Color="#FF282B33" />
            <SolidColorBrush x:Key="StudioWorkspaceCanvasBrush" Color="#FF121418" />
            <SolidColorBrush x:Key="StudioWorkspaceCardFillBrush" Color="#FF202229" />
            <SolidColorBrush x:Key="StudioLogHeaderBackgroundBrush" Color="#FF1A1D23" />
            <SolidColorBrush x:Key="StudioLogPanelBackgroundBrush" Color="#FF16181E" />
            <SolidColorBrush x:Key="StudioLogTerminalFillBrush" Color="#FF12151B" />
            <SolidColorBrush x:Key="StudioSplitDividerBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="StudioCardBorderBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="StudioInputFillBrush" Color="#FF17191E" />
            <SolidColorBrush x:Key="StudioTextPrimaryBrush" Color="#FFF1F5F9" />
            <SolidColorBrush x:Key="StudioTextSecondaryBrush" Color="#FF94A3B8" />
            <SolidColorBrush x:Key="StudioTextTertiaryBrush" Color="#FF64748B" />
            <SolidColorBrush x:Key="StudioAccentBlueBrush" Color="#FF60A5FA" />
            <SolidColorBrush x:Key="StudioAccentBlueFillBrush" Color="#240A84FF" />
            <SolidColorBrush x:Key="StudioAccentBlueBorderBrush" Color="#4D0A84FF" />
            <SolidColorBrush x:Key="StudioSurfaceButtonBrush" Color="#FF262A34" />
            <SolidColorBrush x:Key="StudioSurfaceButtonHoverBrush" Color="#FF303542" />
            <SolidColorBrush x:Key="StudioSurfaceButtonPressedBrush" Color="#FF1E222B" />
            <SolidColorBrush x:Key="StudioPrimaryBtnBgBrush" Color="#FF0A84FF" />
            <SolidColorBrush x:Key="StudioPrimaryBtnHoverBrush" Color="#FF2192FF" />
            <SolidColorBrush x:Key="StudioPrimaryBtnPressedBrush" Color="#FF006EE6" />
            <SolidColorBrush x:Key="StudioPrimaryBtnDisabledBrush" Color="#550A84FF" />
            <SolidColorBrush x:Key="StudioAccentGreenBrush" Color="#FF34D399" />
            <SolidColorBrush x:Key="StudioAccentGreenFillBrush" Color="#2910B981" />
            <SolidColorBrush x:Key="StudioAccentOrangeBrush" Color="#FFFBBF24" />
            <SolidColorBrush x:Key="StudioAccentOrangeFillBrush" Color="#29F59E0B" />
            <SolidColorBrush x:Key="StudioAccentRedBrush" Color="#FFF87171" />
            <SolidColorBrush x:Key="StudioAccentRedFillBrush" Color="#29EF4444" />
            <SolidColorBrush x:Key="StudioAccentPurpleBrush" Color="#FFA78BFA" />
            <SolidColorBrush x:Key="StudioAccentPurpleFillBrush" Color="#298B5CF6" />

            <!-- SwiftUI system colours (dark appearance) — used by Controls/ (StatusDot, cards, drop well) -->
            <SolidColorBrush x:Key="StudioSystemAccentBrush" Color="#FF0A84FF" />
            <SolidColorBrush x:Key="StudioSystemGreenBrush" Color="#FF30D158" />
            <SolidColorBrush x:Key="StudioSystemOrangeBrush" Color="#FFFF9F0A" />
            <SolidColorBrush x:Key="StudioSystemRedBrush" Color="#FFFF453A" />
            <!-- `.secondary.opacity(0.45)` / `.secondary.opacity(0.5)` (idle status dots) -->
            <SolidColorBrush x:Key="StudioSecondaryOpacity45Brush" Color="#3FFFFFFF" />
            <SolidColorBrush x:Key="StudioSecondaryOpacity50Brush" Color="#46FFFFFF" />
            <!-- `Color.primary.opacity(0.06)` (badge capsules) / `.opacity(0.32)` (hover crosshair) -->
            <SolidColorBrush x:Key="StudioPrimaryOpacity06Brush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="StudioPrimaryOpacity32Brush" Color="#52FFFFFF" />
            <!-- Telemetry plots -->
            <SolidColorBrush x:Key="StudioTelemetryPlotFillBrush" Color="#42000000" />
            <SolidColorBrush x:Key="StudioTelemetryCombinedPlotFillBrush" Color="#47000000" />
            <SolidColorBrush x:Key="StudioTelemetryGridLineBrush" Color="#13FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="StudioSidebarBackgroundBrush" Color="#FFF0F2F6" />
            <SolidColorBrush x:Key="StudioSidebarCardFillBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="StudioWorkspaceCanvasBrush" Color="#FFF7F8FA" />
            <SolidColorBrush x:Key="StudioWorkspaceCardFillBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="StudioLogHeaderBackgroundBrush" Color="#FFF2F4F7" />
            <SolidColorBrush x:Key="StudioLogPanelBackgroundBrush" Color="#FFF3F5F8" />
            <SolidColorBrush x:Key="StudioLogTerminalFillBrush" Color="#FF12151B" />
            <SolidColorBrush x:Key="StudioSplitDividerBrush" Color="#FFDCE2EC" />
            <SolidColorBrush x:Key="StudioCardBorderBrush" Color="#FFE2E7F0" />
            <SolidColorBrush x:Key="StudioInputFillBrush" Color="#FFF8F9FC" />
            <SolidColorBrush x:Key="StudioTextPrimaryBrush" Color="#FF0F172A" />
            <SolidColorBrush x:Key="StudioTextSecondaryBrush" Color="#FF526074" />
            <SolidColorBrush x:Key="StudioTextTertiaryBrush" Color="#FF94A3B8" />
            <SolidColorBrush x:Key="StudioAccentBlueBrush" Color="#FF007AFF" />
            <SolidColorBrush x:Key="StudioAccentBlueFillBrush" Color="#17007AFF" />
            <SolidColorBrush x:Key="StudioAccentBlueBorderBrush" Color="#3D007AFF" />
            <SolidColorBrush x:Key="StudioSurfaceButtonBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="StudioSurfaceButtonHoverBrush" Color="#FFF1F5F9" />
            <SolidColorBrush x:Key="StudioSurfaceButtonPressedBrush" Color="#FFE8EEF5" />
            <SolidColorBrush x:Key="StudioPrimaryBtnBgBrush" Color="#FF007AFF" />
            <SolidColorBrush x:Key="StudioPrimaryBtnHoverBrush" Color="#FF006AE0" />
            <SolidColorBrush x:Key="StudioPrimaryBtnPressedBrush" Color="#FF005BC4" />
            <SolidColorBrush x:Key="StudioPrimaryBtnDisabledBrush" Color="#78007AFF" />
            <SolidColorBrush x:Key="StudioAccentGreenBrush" Color="#FF059669" />
            <SolidColorBrush x:Key="StudioAccentGreenFillBrush" Color="#2410B981" />
            <SolidColorBrush x:Key="StudioAccentOrangeBrush" Color="#FFD97706" />
            <SolidColorBrush x:Key="StudioAccentOrangeFillBrush" Color="#24F59E0B" />
            <SolidColorBrush x:Key="StudioAccentRedBrush" Color="#FFDC2626" />
            <SolidColorBrush x:Key="StudioAccentRedFillBrush" Color="#24EF4444" />
            <SolidColorBrush x:Key="StudioAccentPurpleBrush" Color="#FF7C3AED" />
            <SolidColorBrush x:Key="StudioAccentPurpleFillBrush" Color="#248B5CF6" />

            <!-- SwiftUI system colours (light appearance) -->
            <SolidColorBrush x:Key="StudioSystemAccentBrush" Color="#FF007AFF" />
            <SolidColorBrush x:Key="StudioSystemGreenBrush" Color="#FF34C759" />
            <SolidColorBrush x:Key="StudioSystemOrangeBrush" Color="#FFFF9500" />
            <SolidColorBrush x:Key="StudioSystemRedBrush" Color="#FFFF3B30" />
            <SolidColorBrush x:Key="StudioSecondaryOpacity45Brush" Color="#39000000" />
            <SolidColorBrush x:Key="StudioSecondaryOpacity50Brush" Color="#40000000" />
            <SolidColorBrush x:Key="StudioPrimaryOpacity06Brush" Color="#0F000000" />
            <SolidColorBrush x:Key="StudioPrimaryOpacity32Brush" Color="#52000000" />
            <SolidColorBrush x:Key="StudioTelemetryPlotFillBrush" Color="#FFF5F7FB" />
            <SolidColorBrush x:Key="StudioTelemetryCombinedPlotFillBrush" Color="#FFF5F7FB" />
            <SolidColorBrush x:Key="StudioTelemetryGridLineBrush" Color="#11000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Terminal text is always light (terminal fill is dark in both themes) -->
    <SolidColorBrush x:Key="StudioTerminalTextBrush" Color="#FFCBD5E1" />
    <FontFamily x:Key="StudioMonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Allow compact 28px inputs without clipping the bottom border of TextBox/PasswordBox -->
    <x:Double x:Key="TextControlThemeMinHeight">26</x:Double>
    <Thickness x:Key="TextControlThemePadding">8,4,8,4</Thickness>

    <!-- Shared card container style: macOS SidebarCard / WorkspaceCard equivalent -->
    <Style x:Key="StudioSidebarCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource StudioSidebarCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StudioCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="StudioWorkspaceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource StudioWorkspaceCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StudioCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="StudioCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{ThemeResource StudioTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="StudioSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource StudioTextPrimaryBrush}" />
    </Style>

    <!-- SwiftUI `.buttonStyle(.plain)`: content only, no chrome / hover plate -->
    <Style x:Key="StudioPlainButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Background="{TemplateBinding Background}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- EasyColab Primary Action Button (brand blue in both enabled and soft-disabled states) -->
    <Style x:Key="StudioPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource StudioPrimaryBtnBgBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="RootBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource StudioPrimaryBtnHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource StudioPrimaryBtnPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource StudioPrimaryBtnDisabledBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Subtle macOS-like surface button with crisp 1px border and clean hover state -->
    <Style x:Key="StudioSurfaceButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource StudioSurfaceButtonBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource StudioTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StudioCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="RootBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource StudioSurfaceButtonHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource StudioSurfaceButtonPressedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Controls/Cards.cs: SidebarCard (Swift SidebarCard) -->
    <Style TargetType="controls:SidebarCard">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="13" />
        <Setter Property="Background" Value="{ThemeResource StudioSidebarCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StudioCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="0.8" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SidebarCard">
                    <Grid>
                        <Border x:Name="ShadowHost" CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid RowSpacing="11">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource StudioSystemAccentBrush}"
                                        Glyph="{TemplateBinding Icon}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12.5"
                                        FontWeight="Bold"
                                        Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                        Text="{TemplateBinding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Border
                                        x:Name="BadgeCapsule"
                                        Grid.Column="2"
                                        Margin="6,0,0,0"
                                        Padding="7,2"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource StudioPrimaryOpacity06Brush}"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            FontSize="10.5"
                                            FontWeight="Medium"
                                            Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                            Text="{TemplateBinding Badge}" />
                                    </Border>
                                </Grid>
                                <ContentPresenter
                                    Grid.Row="1"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Controls/Cards.cs: WorkspaceCard (Swift WorkspaceCard) -->
    <Style TargetType="controls:WorkspaceCard">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{ThemeResource StudioWorkspaceCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StudioCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="0.8" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:WorkspaceCard">
                    <Grid>
                        <Border x:Name="ShadowHost" CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        x:Name="IconGlyph"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource StudioSystemAccentBrush}"
                                        Glyph="{TemplateBinding Icon}"
                                        Visibility="Collapsed" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                            Text="{TemplateBinding Title}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="SubtitleText"
                                            FontSize="10"
                                            Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                            Text="{TemplateBinding Subtitle}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                    <ContentPresenter
                                        x:Name="TrailingPresenter"
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Trailing}"
                                        Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter
                                    Grid.Row="1"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
