<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EasyColab.Controls.SingleMetricLineChartCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EasyColab.Controls"
    HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <!-- Default (non-warning) colour of the usage readout; code clears the local value to fall back here. -->
        <Style x:Key="UsageTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource StudioTextSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Border
        Padding="8,6.5"
        Background="{ThemeResource StudioInputFillBrush}"
        BorderBrush="{ThemeResource StudioCardBorderBrush}"
        BorderThickness="0.85"
        CornerRadius="9">
        <StackPanel Spacing="4">
            <Grid ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="6.5" Height="6.5" VerticalAlignment="Center">
                    <Border x:Name="DotShadowHost" />
                    <Ellipse x:Name="HeaderDot" />
                </Grid>

                <TextBlock
                    x:Name="TitleText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource StudioTextPrimaryBrush}" />

                <Border
                    x:Name="PercentCapsule"
                    Grid.Column="2"
                    Padding="5,1"
                    VerticalAlignment="Center"
                    CornerRadius="10">
                    <TextBlock
                        x:Name="PercentText"
                        FontFamily="{StaticResource StudioMonoFont}"
                        FontSize="10"
                        FontWeight="Bold" />
                </Border>

                <TextBlock
                    x:Name="UsageText"
                    Grid.Column="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource StudioMonoFont}"
                    FontSize="10.5"
                    FontWeight="Medium"
                    MaxLines="1"
                    Style="{StaticResource UsageTextStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>

            <Grid
                x:Name="PlotHost"
                Height="38"
                Background="Transparent"
                PointerCanceled="PlotHost_PointerExited"
                PointerCaptureLost="PlotHost_PointerExited"
                PointerExited="PlotHost_PointerExited"
                PointerMoved="PlotHost_PointerMoved">
                <Border Background="{ThemeResource StudioTelemetryPlotFillBrush}" CornerRadius="6.5">
                    <Grid>
                        <local:TelemetryGridBackground />
                        <Path x:Name="AreaPath" />
                        <Path
                            x:Name="LinePath"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.75" />
                    </Grid>
                </Border>

                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                    <Line
                        x:Name="HoverLine"
                        StrokeDashArray="2 2"
                        StrokeThickness="1"
                        Visibility="Collapsed" />
                    <Ellipse
                        x:Name="HoverDot"
                        Width="7.2"
                        Height="7.2"
                        Stroke="White"
                        StrokeThickness="1.2"
                        Visibility="Collapsed" />
                    <Border
                        x:Name="HoverLabel"
                        Padding="5,1.5"
                        BorderThickness="0.7"
                        CornerRadius="4"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="HoverLabelText"
                            FontFamily="{StaticResource StudioMonoFont}"
                            FontSize="9.5"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                    </Border>
                    <Ellipse
                        x:Name="LastHalo"
                        Width="10"
                        Height="10"
                        Visibility="Collapsed" />
                    <Ellipse
                        x:Name="LastDot"
                        Width="4.8"
                        Height="4.8"
                        Visibility="Collapsed" />
                </Canvas>

                <Border
                    BorderBrush="{ThemeResource StudioCardBorderBrush}"
                    BorderThickness="0.8"
                    CornerRadius="6.5"
                    IsHitTestVisible="False" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
