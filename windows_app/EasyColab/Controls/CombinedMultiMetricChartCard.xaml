<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EasyColab.Controls.CombinedMultiMetricChartCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EasyColab.Controls"
    HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="AxisLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource StudioMonoFont}" />
            <Setter Property="FontSize" Value="8.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{ThemeResource StudioTextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LegendLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{ThemeResource StudioTextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LegendValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource StudioMonoFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{ThemeResource StudioTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LegendPctStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource StudioMonoFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border
        Padding="8"
        Background="{ThemeResource StudioInputFillBrush}"
        BorderBrush="{ThemeResource StudioCardBorderBrush}"
        BorderThickness="0.85"
        CornerRadius="9">
        <StackPanel Spacing="6">
            <Grid
                x:Name="PlotHost"
                Height="88"
                Background="Transparent"
                PointerCanceled="PlotHost_PointerExited"
                PointerCaptureLost="PlotHost_PointerExited"
                PointerExited="PlotHost_PointerExited"
                PointerMoved="PlotHost_PointerMoved">
                <Border Background="{ThemeResource StudioTelemetryCombinedPlotFillBrush}" CornerRadius="7">
                    <Grid>
                        <local:TelemetryGridBackground />

                        <Grid
                            Padding="4,3,0,3"
                            HorizontalAlignment="Left"
                            IsHitTestVisible="False"
                            Opacity="0.65">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource AxisLabelStyle}" Text="100%" />
                            <TextBlock Grid.Row="2" Style="{StaticResource AxisLabelStyle}" Text="50%" />
                            <TextBlock Grid.Row="4" Style="{StaticResource AxisLabelStyle}" Text="0%" />
                        </Grid>

                        <Path x:Name="VramAreaPath" />
                        <Path
                            x:Name="DiskLinePath"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.55" />
                        <Path
                            x:Name="RamLinePath"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.65" />
                        <Path
                            x:Name="VramLinePath"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.85" />
                    </Grid>
                </Border>

                <Canvas IsHitTestVisible="False">
                    <Line
                        x:Name="HoverLine"
                        Stroke="{ThemeResource StudioPrimaryOpacity32Brush}"
                        StrokeDashArray="2.5 2.5"
                        StrokeThickness="1"
                        Visibility="Collapsed" />
                    <Ellipse
                        x:Name="VramLastDot"
                        Width="5"
                        Height="5"
                        Visibility="Collapsed" />
                    <Ellipse
                        x:Name="RamLastDot"
                        Width="5"
                        Height="5"
                        Visibility="Collapsed" />
                    <Ellipse
                        x:Name="DiskLastDot"
                        Width="5"
                        Height="5"
                        Visibility="Collapsed" />
                </Canvas>

                <Border
                    BorderBrush="{ThemeResource StudioCardBorderBrush}"
                    BorderThickness="0.8"
                    CornerRadius="7"
                    IsHitTestVisible="False" />
            </Grid>

            <StackPanel Spacing="3.5">
                <Grid x:Name="VramLegendRow" ColumnSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="VramSwatch" Width="8" Height="3.5" VerticalAlignment="Center" CornerRadius="2" />
                    <TextBlock x:Name="VramLegendLabel" Grid.Column="1" Style="{StaticResource LegendLabelStyle}" />
                    <TextBlock x:Name="VramLegendValue" Grid.Column="3" Style="{StaticResource LegendValueStyle}" />
                    <TextBlock x:Name="VramLegendPct" Grid.Column="4" Style="{StaticResource LegendPctStyle}" />
                </Grid>
                <Grid x:Name="RamLegendRow" ColumnSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="RamSwatch" Width="8" Height="3.5" VerticalAlignment="Center" CornerRadius="2" />
                    <TextBlock x:Name="RamLegendLabel" Grid.Column="1" Style="{StaticResource LegendLabelStyle}" />
                    <TextBlock x:Name="RamLegendValue" Grid.Column="3" Style="{StaticResource LegendValueStyle}" />
                    <TextBlock x:Name="RamLegendPct" Grid.Column="4" Style="{StaticResource LegendPctStyle}" />
                </Grid>
                <Grid x:Name="DiskLegendRow" ColumnSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DiskSwatch" Width="8" Height="3.5" VerticalAlignment="Center" CornerRadius="2" />
                    <TextBlock x:Name="DiskLegendLabel" Grid.Column="1" Style="{StaticResource LegendLabelStyle}" />
                    <TextBlock x:Name="DiskLegendValue" Grid.Column="3" Style="{StaticResource LegendValueStyle}" />
                    <TextBlock x:Name="DiskLegendPct" Grid.Column="4" Style="{StaticResource LegendPctStyle}" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
